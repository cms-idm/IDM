universe = vanilla
executable = run_wjets_condor_production.sh
arguments = $(job) /store/user/lpcmetx/iDMe/iDMmu_Run3_Production/2022EE/Background_MINIAOD/WJets_WJetsLNu_MLNu0to120_HT100to400_private $(Cluster).$(Process)
should_transfer_files = YES
