# Submit from the run directory (holds cmssw_lib.tgz, samples.txt, logs/); see README.md.
code = /uscms_data/d3/abdelham/CMSSW_13_0_13/src/iDMe/AODSkimmer/dimuon_vertex
flists = /uscms_data/d3/abdelham/CMSSW_13_0_13/src/iDMe/AODSkimmer/fileLists/signal/2022EE/iDMmu
universe = vanilla
executable = $(code)/condor_dimuon_vertex_truth.sh
arguments = $(sample) $(sample)_flist.txt dimuon_vertex_$(sample).root
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = $(code)/dimuon_vertex_truth_cfg.py,$(flists)/$(sample)_flist.txt,cmssw_lib.tgz
transfer_output_files = dimuon_vertex_$(sample).root
output = logs/$(sample)_$(Cluster).out
error = logs/$(sample)_$(Cluster).err
log = logs/condor_$(Cluster).log
request_cpus = 1
request_memory = 2500
request_disk = 2000000
use_x509userproxy = true
x509userproxy = /uscms/home/abdelham/x509up_u15180
environment = "DIMUVTX_REVISION=$(DIMUVTX_REVISION)"
+DesiredOS = "EL8"
+JobBatchName = "dimuon-vertex-truth"
queue sample from samples.txt
